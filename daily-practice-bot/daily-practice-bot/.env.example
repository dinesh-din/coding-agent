# --- LLM ---
ANTHROPIC_API_KEY=sk-ant-xxxx
MODEL_NAME=claude-sonnet-4-5

# --- Git target ---
# Local path to a git clone of the repo you want the bot to commit into.
# Clone it yourself once, with your SSH/HTTPS credentials already working.
PRACTICE_REPO_PATH=/home/you/daily-practice
PRACTICE_REPO_BRANCH=main
GIT_AUTHOR_NAME=Daily Practice Bot
GIT_AUTHOR_EMAIL=you@example.com

# --- Safety ---
# If true, the agent writes files and shows the diff but never commits/pushes.
DRY_RUN=true
# If true, pushes to a new branch and opens a PR instead of pushing to main.
USE_PULL_REQUEST=false
MAX_DIFF_LINES=400

# --- Optional: only needed if USE_PULL_REQUEST=true ---
GITHUB_TOKEN=ghp_xxxx
GITHUB_REPO=yourusername/daily-practice

# --- RAG store ---
CHROMA_PATH=./data/chroma
